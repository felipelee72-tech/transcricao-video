APP_PASSWORD=your_personal_password_here

# Modo de transcricao:
# - free-link-text (padrao): extrai legendas/captions/metadados ja disponiveis no link
# - openai: download + ffmpeg + transcricao via Supabase Edge Function
TRANSCRIPTION_MODE=free-link-text

# Supabase (somente no modo openai — anon key e segura para expor no frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Logs detalhados do yt-dlp (stdout/stderr completos)
DEBUG_YTDLP=false

# Local (opcional)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
TRANSCRIPTION_TMP_DIR=
MAX_SOURCE_SIZE_MB=500
MAX_DURATION_MINUTES=120
CHUNK_MINUTES=10

# Opcional: cookies YouTube (formato Netscape) — melhora taxa de sucesso no Render
# Exporte com extensao "Get cookies.txt LOCALLY" estando logado no YouTube
# YT_DLP_COOKIES_CONTENT=
# YT_DLP_COOKIES_FILE=C:\caminho\cookies.txt

# Render (configurar no painel — nao commitar valores reais)
# NODE_ENV=production
# RENDER=true
# PORT=10000
# CLIENT_ORIGIN=https://seu-app.onrender.com
# YT_DLP_PATH=/opt/render/project/src/.bin/yt-dlp
# SERVE_CLIENT=true
